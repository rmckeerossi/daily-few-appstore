{
  "cleanUrls": true,
  "rewrites": [{ "source": "/c/:id", "destination": "/api/c?id=:id" }],
  "redirects": [{ "source": "/", "destination": "https://dailyfew.com", "permanent": false }],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
